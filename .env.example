# ============================================
# HR Management System - Environment Config
# ============================================

# ──────────── LLM Provider ────────────
# Which LLM to use: "claude" or "gemini"
LLM_PROVIDER=gemini

# Claude (Anthropic) API Key
CLAUDE_API_KEY=your_claude_api_key_here

# Gemini (Google) API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Claude Model
CLAUDE_MODEL=claude-sonnet-4-20250514

# Gemini Model
GEMINI_MODEL=gemini-2.0-flash

# ──────────── Email (IMAP) ────────────
# IMAP server address
# Gmail:   imap.gmail.com
# Outlook: outlook.office365.com
# Yahoo:   imap.mail.yahoo.com
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993

# Your email address
EMAIL_ADDRESS=your_email@gmail.com

# Email password / App Password
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
# For Outlook: use your account password or app password
EMAIL_PASSWORD=your_app_password_here

# Which mailbox folder to scan (default: INBOX)
EMAIL_FOLDER=INBOX

# Only download attachments from emails containing this subject keyword (optional, leave blank for all)
EMAIL_SUBJECT_FILTER=

# Only download from these senders (comma-separated, leave blank for all)
EMAIL_SENDER_FILTER=

# ──────────── Paths ────────────
# Folder where downloaded CVs are stored
CV_FOLDER=./cvs

# Main extraction output
OUTPUT_EXCEL=./output/cv_data.xlsx

# Shortlisted candidates output
SHORTLIST_EXCEL=./output/shortlisted.xlsx

# Job match results output
JOB_MATCH_EXCEL=./output/job_match_results.xlsx

# Email tracking file (stores last processed position)
EMAIL_TRACKER_FILE=./data/email_tracker.json

# Tesseract OCR path (Windows)
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# ──────────── Processing ────────────
MAX_CONCURRENT=3
LOG_LEVEL=INFO

# ──────────── API Server ────────────
API_HOST=0.0.0.0
API_PORT=8000
